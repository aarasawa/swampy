---
import '../styles/global.scss';
import Nav from '../components/Nav.tsx';
import CookieConsent from '../components/CookieConsent.tsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alex Arasawa | Engineering & Portfolio',
  description = 'Portfolio of Alex Arasawa - Applications Engineer and Full-Stack Developer specialized in civic tech and nonprofit infrastructure.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=VT323&family=Outfit:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon-180x180.png" />
  </head>

  <body>
    <div class="noise-layer" aria-hidden="true"></div>
    <Nav currentPath={currentPath} client:load />
    <main class="layout-main" id="main-content">
      <slot />
    </main>
    <footer class="layout-footer">
      <div class="layout-footer__container">
        <div class="layout-footer__copy">
          © 2026
          <span class="layout-footer__agency">Deep Phosphor Studios</span>
          <span class="layout-footer__dot"></span>
          All Rights Reserved
          <span class="layout-footer__dot"></span>
          <a href="/privacy" style="color:inherit;text-decoration:none;">
            Privacy Policy & CCPA
          </a>
        </div>
        <div class="layout-footer__sig">ARASAWA.DEV</div>
      </div>
    </footer>
    <CookieConsent client:load />
  </body>
</html>